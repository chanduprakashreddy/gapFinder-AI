# Choose one AI provider. All free cloud tiers have rate limits.
# Gemini API Key (free tier available at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...
CHAT_MODEL=gemini-3.5-flash

# Groq is OpenAI-compatible and has a free tier for quiz/chat generation.
# It automatically uses local, no-key 768-dimensional embeddings.
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# CHAT_MODEL=openai/gpt-oss-20b
# EMBEDDING_PROVIDER=local

# OpenRouter is OpenAI-compatible and has free models. It also uses local,
# no-key embeddings in this project.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# CHAT_MODEL=openrouter/free
# EMBEDDING_PROVIDER=local

# Or OpenAI API Key
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini

# Supabase Settings
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# Optional
EXPLAIN_MIN_SIM=0.35
